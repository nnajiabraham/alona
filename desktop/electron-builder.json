{
  "appId": "com.alona.app",
  "productName": "Alona",
  "copyright": "Alona",
  "directories": {
    "output": "out",
    "buildResources": "resources"
  },
  "files": [
    "main.js",
    "package.json",
    "resources/icon.png",
    { "from": "../dist/desktop-site", "to": "site", "filter": ["**/*", "!.exact/**"] }
  ],
  "asar": true,
  "publish": null,
  "electronFuses": {
    "runAsNode": false,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableCookieEncryption": true,
    "onlyLoadAppFromAsar": true,
    "loadBrowserProcessSpecificV8Snapshot": false,
    "grantFileProtocolExtraPrivileges": false
  },
  "linux": {
    "target": [{ "target": "deb", "arch": ["x64", "arm64"] }],
    "executableName": "alona",
    "icon": "resources/icon.png",
    "category": "Office",
    "synopsis": "Private meeting notes, made on this computer",
    "maintainer": "Alona <alona@localhost>",
    "desktop": {
      "entry": {
        "Name": "Alona",
        "Comment": "Private meeting notes, made on this computer",
        "StartupWMClass": "Alona"
      }
    }
  },
  "deb": {
    "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0", "libuuid1",
      "libsecret-1-0", "libasound2t64 | libasound2", "libgbm1", "libdrm2"]
  },
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "resources/icon.png",
    "executableName": "Alona"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "Alona-Setup-${version}-${arch}.${ext}"
  }
}
