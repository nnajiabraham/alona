// Alona: private meeting notes. The view asks app.ts for the library, the
// device's model tiers and one meeting's files; app.ts runs the pipeline
// (core/pipeline.ts) one step per tick. Recording is @exact/recording's.
use EmptyState, Badge from "exact:content"
use getUserMedia, stopTrack, microphoneStatus, MediaStream, MediaStreamTrack, MicrophoneStatus from "@exact/media-capture"
use startMediaRecorder, stopMediaRecorder, mediaRecorderState, MediaRecorderInfo, RecordedMedia from "@exact/recording"

routes nav
  home "/"
    meeting "/meeting/:id"
    record "/record"
    settings "/settings"

shape Time
  epochAtZero: number
  utcOffset: number

shape TierView
  id: string
  label: string
  blurb: string
  sttName: string
  llmName: string
  downloadLabel: string
  runnable: bool
  reason: string
  installed: bool
  downloading: bool
  progress: number
  error: string

shape Setup
  ready: bool
  demo: bool
  demoNote: string
  deviceLine: string
  recommended: string
  recommendedLabel: string
  active: string
  activeLabel: string
  activeInstalled: bool
  activeDownloading: bool
  activeProgress: number
  activeDownloadLabel: string
  activeError: string
  tiers: TierView[]

shape MeetingRow
  id: string
  title: string
  createdAt: number
  durationS: number
  status: string
  statusLabel: string
  progress: number

shape SegmentView
  id: string
  at: string
  text: string

shape MeetingDetail
  found: bool
  id: string
  title: string
  createdAt: number
  durationS: number
  audio: string
  status: string
  statusLabel: string
  progress: number
  error: string
  aiNotes: string
  userNotes: string
  segments: SegmentView[]

shape Reply
  ok: bool
  error: string

shape Tick
  working: bool

fn pad2(n: number): string = n < 10 ? `0${n}` : `${n}`
fn clock(seconds: number): string = `${floor(seconds / 60)}:${pad2(floor(seconds) % 60)}`
fn lasted(seconds: number): string = seconds < 60 ? `${round(seconds)} sec` : `${round(seconds / 60)} min`
fn percent(fraction: number): string = `${round(fraction * 100)}%`
fn downloadOnce(size: string): string = size == "" ? "" : ` ${size} to download once.`
fn tierLine(t: TierView): string = t.downloadLabel == "" ? `${t.sttName} · ${t.llmName}` : `${t.sttName} · ${t.llmName} · ${t.downloadLabel}`
fn working(status: string): bool = status == "recorded" or status == "transcribing" or status == "summarizing"

component Alona
  state welcomed = false persist
  state picked = "auto" persist
  state now = 0
  // The recording in progress: its microphone track, its recorder, the meeting it becomes.
  state trackId = ""
  state recorderId = ""
  state recId = ""
  state recStartedAt = 0
  state recTitle = ""
  state recNotes = ""
  // The detail's panes and the notes being typed there.
  state pane = "ai"
  state noteDraft = ""
  state noteDirty = false
  state noteSent = ""
  // The meeting the draft belongs to. The platform's Back leaves a meeting without running an action,
  // so a save must not depend on which meeting is on screen when it fires.
  state noteFor = ""
  state titleDraft = ""
  state aimed = ""

  resource time = exactTime() as shape Time
  resource setup = loadSetup(picked) as shape Setup else empty()
  resource lib = loadMeetings() as shape MeetingRow[] else empty()
  resource mic = microphoneStatus() as shape MicrophoneStatus else empty()
  resource rec = mediaRecorderState(recorder=recorderId, interval=250) as shape MediaRecorderInfo else empty()
  derive selected = match stack(nav).filter(e => e.name == "meeting").at(-1) { case some(e) => e.params.id, case none => "" }
  resource detail = loadMeeting(selected) when selected != "" as shape MeetingDetail else empty()

  mutation ticked as shape Tick refreshes lib, setup, detail
  mutation downloading as shape Reply refreshes setup
  mutation removedModels as shape Reply refreshes setup
  mutation opened as shape MediaStream then arm
  mutation started as shape MediaRecorderInfo then begun
  mutation saved as shape RecordedMedia then filed
  mutation stopped as shape MediaStreamTrack
  mutation created as shape Reply refreshes lib
  mutation notesSaved as shape Reply refreshes detail then afterNotesSaved
  mutation renamed as shape Reply refreshes lib, detail
  mutation deleted as shape Reply refreshes lib
  mutation retried as shape Reply refreshes lib, detail

  derive recording = recorderId != ""
  derive micDenied = mic.state == "denied"
  derive startFailure = match failure(started) { case some(f) => f.code, case none => "" }
  derive anyWorking = lib.filter(m => working(m.status)).length > 0
  derive busy = anyWorking or setup.activeDownloading or not setup.ready
  derive shownNotes = noteDirty and noteFor == selected ? noteDraft : detail.userNotes
  derive today = time.epochAtZero + now

  task pump when busy
    every(1000, tick)
  action tick
    now = performanceNow()
    if not pending(ticked)
      send ticked = tickPipeline(picked)

  task autosave when noteDirty key=noteDraft
    after(800, saveNote)

  action begin
    welcomed = true
    if not setup.activeInstalled and not setup.activeDownloading
      send downloading = downloadTier(setup.active)
  action skipDownload
    welcomed = true
  action download(tier: string)
    send downloading = downloadTier(tier)
  action removeTier(tier: string)
    send removedModels = removeTierModels(tier)
  action pick(tier: string)
    picked = tier

  action follow(url: string)
    if noteDirty and noteFor != ""
      send notesSaved = saveNotes(noteFor, noteDraft)
    noteDirty = false
    pane = "ai"
    nav = top(nav).name == "meeting" and url.startsWith("/meeting/") ? replace(nav, url) : go(nav, url)
  action back
    if noteDirty and noteFor != ""
      send notesSaved = saveNotes(noteFor, noteDraft)
    noteDirty = false
    nav = back(nav)
  action openSettings
    nav = push(nav, "/settings")
  action openSystemSettings
    openURL("app-settings:")

  // Recording: the microphone opens, the recorder starts, then the record screen shows.
  action startRecording
    recTitle = ""
    recNotes = ""
    send opened = getUserMedia(audio=true)
  action arm
    match opened
      case some(s)
        let at = round(time.epochAtZero + performanceNow())
        trackId = match s.tracks.at(0) { case some(t) => t.id, case none => "" }
        recId = `m${at}`
        recStartedAt = at
        send started = startMediaRecorder(stream=s.id, path=`app:/data/meetings/m${at}/audio`)
      case none
        trackId = ""
  action begun
    match started
      case some(r)
        recorderId = r.id
        nav = push(nav, "/record")
      case none
        recorderId = ""
        recId = ""
  task abandon when failed(started) key=true
    change(abandoned)
  action abandoned
    if trackId != ""
      send stopped = stopTrack(track=trackId)
    trackId = ""
    recId = ""
  action editRecTitle(v: string)
    recTitle = v
  action editRecNotes(v: string)
    recNotes = v
  action stopRecording
    if recording and not pending(saved)
      send saved = stopMediaRecorder(recorder=recorderId)
  action filed
    match saved
      case some(m)
        send created = createMeeting(recId, recTitle.trim(), m.path, m.duration, recNotes, recStartedAt, setup.active)
        send stopped = stopTrack(track=trackId)
        nav = replace(nav, path("meeting", recId))
        trackId = ""
        recorderId = ""
        recId = ""
      case none
        recorderId = recorderId

  // The detail: panes, the notes pad's autosave, the title, retry and delete.
  action showPane(p: string)
    pane = p
  action editNote(v: string)
    noteDraft = v
    noteDirty = true
    noteFor = selected
  action saveNote
    if noteDirty and noteFor != ""
      noteSent = noteDraft
      send notesSaved = saveNotes(noteFor, noteDraft)
  action afterNotesSaved
    if noteDraft == noteSent
      noteDirty = false
  action editTitle(v: string)
    titleDraft = v
  action commitTitle(v: string)
    if selected != "" and v.trim() != detail.title
      send renamed = renameMeeting(selected, v.trim())
  action retry
    send retried = retryMeeting(selected)
  action regenerate
    send retried = regenerateNotes(selected)
  action retranscribe
    send retried = retranscribeMeeting(selected)
  action askDelete(id: string)
    aimed = id
    showModal("delete-meeting")
  action remove(id: string)
    send deleted = deleteMeeting(id)
    if selected == id
      nav = back(nav)

  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="app" width="100%" height="100%"
      background-color="surface.page" color="text.primary" accent-color="moss.fill"
      for e in stack(nav) key=e.id
        if e.name == "home"
          if welcomed
            column navigationKey=`${e.id}` navigationScroll="home-scroll" position="absolute" inset=0
              display="flex" flex-direction="column"
              header display="flex" align-items="center" gap=8 padding="8px 16px" background-color="surface.page"
                text "Alona" role="heading" aria-level=1 flex=1
                button press=openSettings aria-label="Settings" testId="open-settings"
                  image "symbol:settings"
              scroll id="home-scroll" flex=1 min-height=0
                column gap=16 padding=16 max-width="45rem" width="100%" margin="0 auto" box-sizing="border-box"
                  ModelBanner(setup=setup, download=download(setup.active), openSettings=openSettings)
                  RecordCard(recording=recording, opening=(pending(opened) or pending(started)), denied=micDenied,
                    available=mic.available, failure=startFailure, start=startRecording, openSystemSettings=openSystemSettings)
                  if failed(lib)
                    EmptyState(symbol="symbol:alert", title="Can’t open your meetings", message="The meetings folder could not be read.")
                  else if lib.length == 0 and not pending(lib)
                    EmptyState(symbol="symbol:waveform", title="No meetings yet", message="Record one and Alona writes the notes on this device.")
                  else
                    column gap=8 testId="meetings"
                      text "Meetings" font="-exact-headline" color="text.muted"
                      for m in lib key=m.id
                        link href=path("meeting", m.id) testId=`meeting-${m.id}`
                          display="flex" align-items="center" gap=12 padding=14 border-radius=14 background-color="surface.card"
                          column flex=1 min-width=0 gap=2
                            text m.title font="-exact-headline" line-clamp=1 testId=`meeting-title-${m.id}`
                            text `${formatDay(m.createdAt, today, time.utcOffset, "list")} · ${lasted(m.durationS)}`
                              font="-exact-footnote" color="text.muted"
                          StatusChip(status=m.status, label=m.statusLabel, progress=m.progress)
          else
            column navigationKey=`${e.id}` navigationBar="none" position="absolute" inset=0 testId="welcome"
              scroll flex=1 min-height=0
                column min-height="100%" box-sizing="border-box" padding=24 gap=20 justify-content="center"
                  max-width="32.5rem" width="100%" margin="0 auto"
                  column gap=8
                    text "Alona" font="-exact-large-title" role="heading" aria-level=1
                    text "Meeting notes that never leave this device." font="-exact-title3" color="text.muted"
                  column gap=10 padding=16 border-radius=16 background-color="surface.card" testId="device-card"
                    text "This device" font="-exact-footnote" color="text.muted"
                    if setup.ready
                      text setup.deviceLine testId="device-line"
                      row gap=8 align-items="center"
                        image "symbol:checkmark" color="moss.fill"
                        text `Best fit: ${setup.recommendedLabel}` font="-exact-headline" testId="recommended"
                      for t in setup.tiers.filter(t => t.id == setup.recommended) key=t.id
                        text t.blurb font="-exact-footnote" color="text.muted"
                        text `${t.sttName} for transcripts, ${t.llmName} for notes.${downloadOnce(t.downloadLabel)}`
                          font="-exact-footnote" color="text.muted" testId="recommended-models"
                      if setup.demo
                        text setup.demoNote font="-exact-footnote" color="ochre.ink" testId="demo-note"
                    else
                      row gap=8 align-items="center"
                        progress aria-label="Checking this device"
                        text "Checking what this device can run…" color="text.muted"
                  column gap=6
                    Promise(symbol="symbol:lock", text="Audio, transcripts and notes stay on this device.")
                    Promise(symbol="symbol:download", text="Models download once, then work offline.")
                    Promise(symbol="symbol:adjust", text="You can switch to a lighter model in Settings.")
              column gap=8 padding=24 max-width="32.5rem" width="100%" margin="0 auto" box-sizing="border-box"
                button press=begin buttonStyle="filled" disabled=(not setup.ready) testId="continue"
                  text (setup.activeInstalled ? "Continue" : "Download models and continue")
                if setup.ready and not setup.activeInstalled
                  button press=skipDownload testId="skip-download"
                    text "Not now"
        if e.name == "record"
          column navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll="record-scroll" position="absolute" inset=0
            display="flex" flex-direction="column" testId="record-screen"
            header display="flex" align-items="center" padding="8px 16px"
              // Back, a swipe down and Escape press this, so leaving the screen always stops the recorder.
              button id="back" press=stopRecording disabled=pending(saved) aria-label="Stop and write notes" testId="record-back"
                image "symbol:stop-fill"
              text "Recording" role="heading" aria-level=2
            scroll id="record-scroll" flex=1 min-height=0
              column gap=16 padding=16 max-width="45rem" width="100%" margin="0 auto" box-sizing="border-box"
                column gap=10 padding=16 border-radius=16 background-color="clay.soft" align-items="center"
                  row gap=8 align-items="center"
                    view width=10 height=10 border-radius=5 background-color="clay.fill"
                    text clock(rec.duration / 1000) font="-exact-large-title" font-variant-numeric="tabular-nums"
                      color="clay.ink" testId="elapsed"
                  audio-waveform track=trackId tint="#a8553a" width="100%" height=72 testId="waveform"
                  button press=stopRecording buttonStyle="filled" disabled=pending(saved) testId="stop-recording"
                    image "symbol:stop-fill"
                    text (pending(saved) ? "Saving…" : "Stop and write notes")
                input value=recTitle input=editRecTitle placeholder="Meeting title (optional)" aria-label="Meeting title"
                  testId="record-title"
                column gap=6
                  text "Your notes" font="-exact-headline"
                  text "Markdown works here. Alona covers what you write first." font="-exact-footnote" color="text.muted"
                  textarea value=recNotes input=editRecNotes markup="markdown" placeholder="- Topics, decisions, follow-ups"
                    aria-label="Your notes" rows=10 testId="record-notes" min-height=220
        if e.name == "meeting"
          column navigationKey=`${e.id}` navigationScroll="meeting-scroll" position="absolute" inset=0
            display="flex" flex-direction="column"
            header display="flex" align-items="center" gap=8 padding="8px 16px"
              text "Meeting" role="heading" aria-level=2 flex=1
              button press=askDelete(e.params.id) aria-label="Delete meeting" testId="delete-meeting"
                image "symbol:delete"
            if detail.found
              scroll id="meeting-scroll" flex=1 min-height=0
                column gap=16 padding=16 max-width="45rem" width="100%" margin="0 auto" box-sizing="border-box"
                  column gap=4
                    input value=detail.title change=commitTitle aria-label="Title" border="none" font="-exact-title2"
                      testId="title-field"
                    text `${formatDate(detail.createdAt, time.utcOffset, "medium")} · ${formatTime(detail.createdAt, time.utcOffset, "short")} · ${lasted(detail.durationS)}`
                      font="-exact-footnote" color="text.muted" testId="detail-meta"
                  if detail.audio != ""
                    audio src=detail.audio controls=true preload="metadata" width="100%" testId="player"
                  if setup.demo
                    text setup.demoNote font="-exact-footnote" color="ochre.ink" testId="detail-demo-note"
                  if working(detail.status)
                    column gap=8 padding=14 border-radius=14 background-color="moss.soft" testId="working-card"
                      text detail.statusLabel color="moss.ink" font="-exact-headline" testId="working-label"
                      progress value=detail.progress max=1 aria-label=detail.statusLabel
                  if detail.status == "failed"
                    column gap=8 padding=14 border-radius=14 background-color="clay.soft" testId="failed-card"
                      text detail.statusLabel color="clay.ink" font="-exact-headline"
                      text detail.error color="clay.ink" font="-exact-footnote" testId="failed-error"
                      button press=retry buttonStyle="bordered" disabled=pending(retried) testId="retry"
                        text "Try again"
                  row role="radiogroup" aria-label="Show" width="100%"
                    button role="radio" aria-checked=(pane == "ai") press=showPane("ai") flex=1 testId="pane-ai"
                      text "AI notes"
                    button role="radio" aria-checked=(pane == "mine") press=showPane("mine") flex=1 testId="pane-mine"
                      text "My notes"
                    button role="radio" aria-checked=(pane == "transcript") press=showPane("transcript") flex=1 testId="pane-transcript"
                      text "Transcript"
                  if pane == "ai"
                    if detail.aiNotes != ""
                      column gap=10 padding=16 border-radius=14 background-color="surface.card"
                        text detail.aiNotes markup="markdown" testId="ai-notes"
                      button press=regenerate disabled=(pending(retried) or working(detail.status)) testId="regenerate"
                        image "symbol:refresh"
                        text "Write again"
                    else
                      text (working(detail.status) ? "Notes appear here when the transcript is ready." : "No AI notes for this meeting.")
                        color="text.muted" testId="ai-empty"
                  if pane == "mine"
                    column gap=6
                      textarea value=shownNotes input=editNote markup="markdown" placeholder="Write in Markdown"
                        aria-label="My notes" rows=12 min-height=260 testId="my-notes"
                      text (noteDirty ? "Saving…" : "Saved on this device") font="-exact-footnote" color="text.muted" testId="notes-state"
                  if pane == "transcript"
                    if not working(detail.status)
                      button press=retranscribe disabled=pending(retried) testId="retranscribe"
                        image "symbol:refresh"
                        text "Transcribe again"
                    if detail.segments.length == 0
                      text (working(detail.status) ? "Transcribing…" : "No speech was found in this recording.") color="text.muted" testId="transcript-empty"
                    else
                      column gap=10 testId="transcript"
                        for s in detail.segments key=s.id
                          row gap=12 align-items="flex-start"
                            text s.at font="-exact-footnote" color="text.muted" font-variant-numeric="tabular-nums" width="2.75rem" flex-shrink=0
                            text s.text flex=1 min-width=0
            else if not pending(detail)
              EmptyState(symbol="symbol:alert", title="No such meeting", message="It may have been deleted.")
                button press=back buttonStyle="filled" testId="missing-back"
                  text "Back to meetings"
        if e.name == "settings"
          column navigationKey=`${e.id}` navigationScroll="settings-list" position="absolute" inset=0
            display="flex" flex-direction="column"
            header display="flex" align-items="center" padding="8px 16px"
              text "Settings" role="heading" aria-level=2
            list id="settings-list" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 testId="settings"
              section
                header
                  text "This device"
                row
                  text setup.deviceLine flex=1 testId="settings-device"
                footer
                  text `Alona recommends ${setup.recommendedLabel} here.` testId="settings-recommended"
              section
                header
                  text "Models"
                button press=pick("auto") testId="tier-auto"
                  column flex=1 min-width=0 gap=2
                    text `Automatic (${setup.recommendedLabel})`
                    text "Use the best fit for this device." font="-exact-footnote" color="-exact-secondary-label"
                  if picked == "auto"
                    image "symbol:checkmark"
                for t in setup.tiers key=t.id
                  button press=pick(t.id) disabled=(not t.runnable) testId=`pick-${t.id}`
                    column flex=1 min-width=0 gap=2
                      text t.label
                      text t.blurb font="-exact-footnote" color="-exact-secondary-label"
                      text (t.runnable ? tierLine(t) : t.reason) font="-exact-footnote" color="-exact-secondary-label"
                        testId=`tier-line-${t.id}`
                    if picked == t.id
                      image "symbol:checkmark"
                  if t.runnable
                    TierDownload(tier=t, download=download(t.id), remove=removeTier(t.id))
                footer
                  text "A lighter model uses less memory and battery. A larger one writes better notes."
              section
                header
                  text "Privacy"
                footer
                  text "Recordings, transcripts and notes are stored and processed on this device. Alona only goes online to download models."
      dialog id="delete-meeting" role="alertdialog" aria-label="Delete this meeting?"
        text "Its recording, transcript and notes are removed from this device."
        button press=remove(aimed) destructive=true commandfor="delete-meeting" command="close" testId="delete-confirm"
          text "Delete"
        button commandfor="delete-meeting" command="close" testId="delete-cancel"
          text "Cancel"

component Promise
  props
    symbol: string
    text: string
  view
    row gap=10 align-items="center"
      image symbol color="moss.fill"
      text text font="-exact-footnote" color="text.muted" flex=1 min-width=0

// What the active tier still needs before a meeting can be processed.
component ModelBanner
  props
    setup: Setup
    download: action
    openSettings: action
  view
    column gap=8
      if setup.demo
        row gap=8 padding=12 border-radius=14 background-color="ochre.soft" testId="demo-banner"
          text setup.demoNote color="ochre.ink" font="-exact-footnote" flex=1 min-width=0
      if setup.ready and setup.activeDownloading
        column gap=8 padding=14 border-radius=14 background-color="moss.soft" testId="download-card"
          text `Downloading ${setup.activeLabel} models · ${percent(setup.activeProgress)}` color="moss.ink" font="-exact-headline" testId="download-label"
          progress value=setup.activeProgress max=1 aria-label="Model download"
      else if setup.ready and not setup.activeInstalled
        column gap=8 padding=14 border-radius=14 background-color="moss.soft" testId="models-needed"
          text `${setup.activeLabel} models are not on this device yet.` color="moss.ink" font="-exact-headline"
          if setup.activeError != ""
            text setup.activeError color="clay.ink" font="-exact-footnote" testId="download-error"
          text "New recordings are transcribed once the models are downloaded." color="moss.ink" font="-exact-footnote"
          row gap=8 flex-wrap="wrap"
            button press=download buttonStyle="filled" testId="download-models"
              text "Download"
            button press=openSettings testId="choose-model"
              text "Choose another"

component RecordCard
  props
    recording: bool
    opening: bool
    denied: bool
    available: bool
    failure: string
    start: action
    openSystemSettings: action
  view
    column gap=10 padding=20 border-radius=18 background-color="surface.raised" border="1px solid" border-color="line.soft"
      align-items="center" box-sizing="border-box" testId="record-card"
      text "Ready when your meeting starts" font="-exact-title3" text-align="center"
      button press=start buttonStyle="filled" disabled=(opening or recording or denied or not available) testId="start-recording"
        max-width="100%"
        image "symbol:microphone"
        text (opening ? "Opening microphone…" : "Record a meeting")
      if denied
        text "The microphone is off for Alona. Turn it on in Settings to record." font="-exact-footnote" color="clay.ink" text-align="center" testId="mic-denied"
        button press=openSystemSettings testId="mic-settings"
          text "Open Settings"
      else if not available
        text "Recording is not available on this device." font="-exact-footnote" color="text.muted" text-align="center" testId="mic-unavailable"
      else if failure != "" and not opening
        text `Recording didn’t start (${failure}).` font="-exact-footnote" color="clay.ink" text-align="center" testId="start-failed"

component StatusChip
  props
    status: string
    label: string
    progress: number
  view
    if status == "done"
      Badge(label="Notes ready", tint=some("moss.fill"))
    else if status == "failed"
      Badge(label="Needs attention", tint=some("clay.fill"))
    else
      Badge(label=`${label} ${percent(progress)}`, tint=some("ochre.ink"))

// Whether a tier's models are on this device, with the button that changes it.
component TierDownload
  props
    tier: TierView
    download: action
    remove: action
  view
    row gap=8 align-items="center" testId=`tier-state-${tier.id}`
      if tier.downloading
        text `Downloading ${tier.label} · ${percent(tier.progress)}` font="-exact-footnote" color="-exact-secondary-label" flex=1
      else if tier.installed
        text `${tier.label} is on this device` font="-exact-footnote" color="-exact-secondary-label" flex=1 testId=`tier-installed-${tier.id}`
        button press=remove testId=`remove-${tier.id}`
          text "Remove"
      else
        text (tier.error != "" ? tier.error : `${tier.label} is not downloaded`) font="-exact-footnote" color="-exact-secondary-label" flex=1
        button press=download testId=`download-${tier.id}`
          text "Download"
