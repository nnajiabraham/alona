// The clinic app: a consultation is recorded, transcribed on the device, and
// a local model drafts a note in the template the clinician picked. The
// clinician edits and reviews the draft before copying it out. Every word of
// brand comes from the tenant (loadBrand); every colour from app.tamber,
// which tools/tenant.mjs writes from the tenant file.
use EmptyState, Badge from "exact:content"
use getUserMedia, stopTrack, microphoneStatus, MediaStream, MediaStreamTrack, MicrophoneStatus from "@exact/media-capture"
use startMediaRecorder, stopMediaRecorder, mediaRecorderState, MediaRecorderInfo, RecordedMedia from "@exact/recording"

routes nav
  home "/"
    note "/note/:id"
    start "/new"
    record "/record"
    settings "/settings"

shape Time
  epochAtZero: number
  utcOffset: number

shape TemplateView
  id: string
  name: string
  description: string
  headings: string

shape Brand
  name: string
  tagline: string
  version: string
  welcomeTitle: string
  welcomeBody: string
  person: string
  persons: string
  Person: string
  reviewDisclaimer: string
  privacy: string
  supportEmail: string
  supportUrl: string
  supportHours: string
  jottings: bool
  copy: bool
  share: bool
  playback: bool
  defaultTemplate: string
  defaultTier: string
  templates: TemplateView[]

shape TierView
  id: string
  label: string
  blurb: string
  sttName: string
  llmName: string
  downloadLabel: string
  runnable: bool
  reason: string
  installed: bool
  downloading: bool
  progress: number
  error: string

shape Setup
  ready: bool
  demo: bool
  demoNote: string
  deviceLine: string
  recommended: string
  recommendedLabel: string
  active: string
  activeLabel: string
  activeInstalled: bool
  activeDownloading: bool
  activeProgress: number
  activeDownloadLabel: string
  activeError: string
  tiers: TierView[]

shape NoteRow
  id: string
  patientRef: string
  templateName: string
  createdAt: number
  durationS: number
  state: string
  stateLabel: string
  progress: number

shape SegmentView
  id: string
  at: string
  text: string

shape NoteDetail
  found: bool
  id: string
  patientRef: string
  templateName: string
  templateId: string
  createdAt: number
  durationS: number
  state: string
  stateLabel: string
  progress: number
  status: string
  audio: string
  error: string
  draft: string
  note: string
  hasEdits: bool
  reviewedAt: number
  jottings: string
  segments: SegmentView[]

shape Reply
  ok: bool
  error: string

shape Tick
  working: bool

fn pad2(n: number): string = n < 10 ? `0${n}` : `${n}`
fn clock(seconds: number): string = `${floor(seconds / 60)}:${pad2(floor(seconds) % 60)}`
fn lasted(seconds: number): string = seconds < 60 ? `${round(seconds)} sec` : `${round(seconds / 60)} min`
fn percent(fraction: number): string = `${round(fraction * 100)}%`
fn downloadOnce(size: string): string = size == "" ? "" : ` ${size} to download once.`
fn tierLine(t: TierView): string = t.downloadLabel == "" ? `${t.sttName} · ${t.llmName}` : `${t.sttName} · ${t.llmName} · ${t.downloadLabel}`

component Clinic
  state welcomed = false persist
  // The clinician's model tier; "" until they pick, when the tenant's default applies.
  state picked = "" persist
  state now = 0
  // The recording in progress: the microphone track, the recorder, and the note it becomes.
  state trackId = ""
  state recorderId = ""
  state recId = ""
  state recStartedAt = 0
  state recRef = ""
  state recTemplate = ""
  state recJottings = ""
  // The note screen: its pane, the edit in progress and the jottings being typed.
  state pane = "note"
  state editing = false
  state editDraft = ""
  state editDirty = false
  state editSent = ""
  // The note an unsaved edit belongs to. The platform's Back leaves a note without running an
  // action, so a save must not depend on which note is on screen when it fires.
  state editFor = ""
  state jotDraft = ""
  state jotDirty = false
  state jotSent = ""
  state jotFor = ""
  state aimed = ""
  state replacing = ""
  state copied = false

  resource brand = loadBrand() as shape Brand else empty()
  resource time = exactTime() as shape Time
  resource setup = loadSetup(picked) as shape Setup else empty()
  resource lib = loadNotes() as shape NoteRow[] else empty()
  resource mic = microphoneStatus() as shape MicrophoneStatus else empty()
  resource rec = mediaRecorderState(recorder=recorderId, interval=250) as shape MediaRecorderInfo else empty()
  derive selected = match stack(nav).filter(e => e.name == "note").at(-1) { case some(e) => e.params.id, case none => "" }
  resource detail = loadNote(selected) when selected != "" as shape NoteDetail else empty()

  mutation ticked as shape Tick refreshes lib, setup, detail
  mutation downloading as shape Reply refreshes setup
  mutation removedModels as shape Reply refreshes setup
  mutation opened as shape MediaStream then arm
  mutation started as shape MediaRecorderInfo then begun
  mutation saved as shape RecordedMedia then filed
  mutation stopped as shape MediaStreamTrack
  mutation created as shape Reply refreshes lib
  mutation editsSaved as shape Reply refreshes detail, lib then afterEditsSaved
  mutation jotsSaved as shape Reply refreshes detail then afterJotsSaved
  mutation refSaved as shape Reply refreshes lib, detail
  mutation reviewed as shape Reply refreshes lib, detail
  mutation deleted as shape Reply refreshes lib
  mutation rerun as shape Reply refreshes lib, detail

  derive choice = picked != "" ? picked : brand.defaultTier
  derive recording = recorderId != ""
  derive micDenied = mic.state == "denied"
  derive startFailure = match failure(started) { case some(f) => f.code, case none => "" }
  derive anyWorking = lib.filter(n => n.state == "processing").length > 0
  derive busy = anyWorking or setup.activeDownloading or not setup.ready
  derive shownNote = editDirty and editFor == selected ? editDraft : detail.note
  derive shownJottings = jotDirty and jotFor == selected ? jotDraft : detail.jottings
  derive today = time.epochAtZero + now
  derive done = detail.status == "done"

  task pump when busy
    every(1000, tick)
  action tick
    now = performanceNow()
    if not pending(ticked)
      send ticked = tickPipeline(choice)

  task autosaveEdits when editDirty key=editDraft
    after(800, saveEdit)
  task autosaveJottings when jotDirty key=jotDraft
    after(800, saveJot)

  action begin
    welcomed = true
    if not setup.activeInstalled and not setup.activeDownloading
      send downloading = downloadTier(setup.active)
  action skipDownload
    welcomed = true
  action download(tier: string)
    send downloading = downloadTier(tier)
  action removeTier(tier: string)
    send removedModels = removeTierModels(tier)
  action pick(tier: string)
    picked = tier

  // Leaving a note by a link or by Back saves what was typed there first.
  action follow(url: string)
    if editDirty and editFor != ""
      send editsSaved = saveEdits(editFor, editDraft)
    if jotDirty and jotFor != ""
      send jotsSaved = saveJottings(jotFor, jotDraft)
    editDirty = false
    jotDirty = false
    editing = false
    copied = false
    pane = "note"
    nav = top(nav).name == "note" and url.startsWith("/note/") ? replace(nav, url) : go(nav, url)
  action back
    if editDirty and editFor != ""
      send editsSaved = saveEdits(editFor, editDraft)
    if jotDirty and jotFor != ""
      send jotsSaved = saveJottings(jotFor, jotDraft)
    editDirty = false
    jotDirty = false
    editing = false
    copied = false
    nav = back(nav)
  action openSettings
    nav = push(nav, "/settings")
  action openNew
    nav = push(nav, "/new")
  action openSystemSettings
    openURL("app-settings:")
  action openSupportMail
    openURL(`mailto:${brand.supportEmail}`)
  action openSupportPage
    openURL(brand.supportUrl)

  // Recording: the sheet names the patient and the template, the microphone opens, the recorder
  // starts, then the record screen takes the sheet's place.
  action startRecording(ref: string, template: string)
    recRef = ref.trim()
    recTemplate = template
    recJottings = ""
    send opened = getUserMedia(audio=true)
  action arm
    match opened
      case some(s)
        let at = round(time.epochAtZero + performanceNow())
        trackId = match s.tracks.at(0) { case some(t) => t.id, case none => "" }
        recId = `m${at}`
        recStartedAt = at
        send started = startMediaRecorder(stream=s.id, path=`app:/data/meetings/m${at}/audio`)
      case none
        trackId = ""
  action begun
    match started
      case some(r)
        recorderId = r.id
        nav = top(nav).name == "start" ? replace(nav, "/record") : push(nav, "/record")
      case none
        recorderId = ""
        recId = ""
  task abandon when failed(started) key=true
    change(abandoned)
  action abandoned
    if trackId != ""
      send stopped = stopTrack(track=trackId)
    trackId = ""
    recId = ""
  action editRecJottings(v: string)
    recJottings = v
  action stopRecording
    if recording and not pending(saved)
      send saved = stopMediaRecorder(recorder=recorderId)
  action filed
    match saved
      case some(m)
        send created = createNote(recId, recRef, recTemplate, m.path, m.duration, recJottings, recStartedAt, setup.active)
        send stopped = stopTrack(track=trackId)
        nav = replace(nav, path("note", recId))
        trackId = ""
        recorderId = ""
        recId = ""
      case none
        recorderId = recorderId

  // The note: panes, the edit and its autosave, review, copy and share, running again, delete.
  action showPane(p: string)
    pane = p
  action startEditing
    editing = true
    copied = false
  action stopEditing
    if editDirty and editFor != ""
      editSent = editDraft
      send editsSaved = saveEdits(editFor, editDraft)
    editing = false
  action editNote(v: string)
    editDraft = v
    editDirty = true
    editFor = selected
  action saveEdit
    if editDirty and editFor != ""
      editSent = editDraft
      send editsSaved = saveEdits(editFor, editDraft)
  action afterEditsSaved
    if editDraft == editSent
      editDirty = false
  action editJottings(v: string)
    jotDraft = v
    jotDirty = true
    jotFor = selected
  action saveJot
    if jotDirty and jotFor != ""
      jotSent = jotDraft
      send jotsSaved = saveJottings(jotFor, jotDraft)
  action afterJotsSaved
    if jotDraft == jotSent
      jotDirty = false
  action commitRef(v: string)
    if selected != "" and v.trim() != detail.patientRef
      send refSaved = setPatientRef(selected, v.trim())
  action markReviewed
    send reviewed = markReviewed(selected, round(time.epochAtZero + performanceNow()))
  action copyNote
    copyText(detail.note)
    copied = true
  action shareNote
    share(title=`${detail.templateName} · ${detail.patientRef}`, text=detail.note)
  action retry
    send rerun = retryNote(selected)
  action askWriteAgain
    if detail.hasEdits
      replacing = "write"
      showModal("replace-edits")
    else
      send rerun = writeAgain(selected)
  action askTranscribeAgain
    if detail.hasEdits
      replacing = "transcribe"
      showModal("replace-edits")
    else
      send rerun = transcribeAgain(selected)
  action replaceEdits
    editing = false
    editDirty = false
    if replacing == "transcribe"
      send rerun = transcribeAgain(selected)
    else
      send rerun = writeAgain(selected)
  action askDelete(id: string)
    aimed = id
    showModal("delete-note")
  action remove(id: string)
    send deleted = deleteNote(id)
    editDirty = false
    jotDirty = false
    if selected == id
      nav = back(nav)

  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="app" width="100%" height="100%"
      background-color="surface.page" color="text.primary"
      for e in stack(nav) key=e.id
        if e.name == "home"
          if welcomed
            column navigationKey=`${e.id}` navigationScroll="home-scroll" position="absolute" inset=0
              display="flex" flex-direction="column"
              header display="flex" align-items="center" gap=8 padding="8px 16px" background-color="surface.page"
                text brand.name role="heading" aria-level=1 flex=1 testId="app-name"
                button press=openSettings aria-label="Settings" testId="open-settings"
                  image "symbol:settings"
              scroll id="home-scroll" flex=1 min-height=0
                column gap=16 padding=16 max-width="45rem" width="100%" margin="0 auto" box-sizing="border-box"
                  ModelBanner(setup=setup, download=download(setup.active), openSettings=openSettings)
                  NewNoteCard(brand=brand, recording=recording, opening=(pending(opened) or pending(started)),
                    denied=micDenied, available=mic.available, failure=startFailure, start=openNew,
                    openSystemSettings=openSystemSettings)
                  if failed(lib)
                    EmptyState(symbol="symbol:alert", title="Can’t open your notes", message="The notes folder could not be read.")
                  else if lib.length == 0 and not pending(lib)
                    EmptyState(symbol="symbol:waveform", title="No notes yet", message=`Record a consultation and ${brand.name} drafts the note on this device.`)
                  else
                    column gap=8 testId="notes"
                      text "Notes" font="-exact-headline" color="text.muted"
                      for n in lib key=n.id
                        link href=path("note", n.id) testId=`note-${n.id}`
                          display="flex" align-items="center" gap=12 padding=14 border-radius=14 background-color="surface.card"
                          column flex=1 min-width=0 gap=2
                            text n.patientRef font="-exact-headline" testId=`note-ref-${n.id}`
                            text `${n.templateName} · ${formatDay(n.createdAt, today, time.utcOffset, "list")} · ${lasted(n.durationS)}`
                              font="-exact-footnote" color="text.muted"
                          StateChip(state=n.state, label=n.stateLabel, progress=n.progress)
          else
            column navigationKey=`${e.id}` navigationBar="none" position="absolute" inset=0 testId="welcome"
              scroll flex=1 min-height=0
                column min-height="100%" box-sizing="border-box" padding=24 gap=20 justify-content="center"
                  max-width="32.5rem" width="100%" margin="0 auto"
                  column gap=8
                    text brand.welcomeTitle font="-exact-large-title" role="heading" aria-level=1 testId="welcome-title"
                    text brand.tagline font="-exact-title3" color="text.muted" testId="tagline"
                    text brand.welcomeBody color="text.muted"
                  column gap=10 padding=16 border-radius=16 background-color="surface.card" testId="device-card"
                    text "This device" font="-exact-footnote" color="text.muted"
                    if setup.ready
                      text setup.deviceLine testId="device-line"
                      row gap=8 align-items="center"
                        image "symbol:checkmark" color="accent"
                        text `Best fit: ${setup.recommendedLabel}` font="-exact-headline" testId="recommended"
                      for t in setup.tiers.filter(t => t.id == setup.active) key=t.id
                        text `${t.sttName} for transcripts, ${t.llmName} for drafts.${downloadOnce(t.downloadLabel)}`
                          font="-exact-footnote" color="text.muted" testId="recommended-models"
                      if setup.demo
                        text setup.demoNote font="-exact-footnote" color="notice.ink" testId="demo-note"
                    else
                      row gap=8 align-items="center"
                        progress aria-label="Checking this device"
                        text "Checking what this device can run…" color="text.muted"
                  column gap=6
                    Promise(symbol="symbol:lock", text=`Recordings, transcripts and notes about your ${brand.persons} stay on this device.`)
                    Promise(symbol="symbol:download", text="Models download once, then work offline.")
                    Promise(symbol="symbol:checkmark", text="Every draft waits for your review.")
              column gap=8 padding=24 max-width="32.5rem" width="100%" margin="0 auto" box-sizing="border-box"
                button press=begin buttonStyle="filled" disabled=(not setup.ready) testId="continue"
                  text (setup.activeInstalled ? "Continue" : "Download models and continue")
                if setup.ready and not setup.activeInstalled
                  button press=skipDownload testId="skip-download"
                    text "Not now"
        if e.name == "start"
          NewNote(route=e.id, brand=brand, opening=(pending(opened) or pending(started)), failure=startFailure,
            start=startRecording, cancel=back)
        if e.name == "record"
          column navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll="record-scroll" position="absolute" inset=0
            display="flex" flex-direction="column" testId="record-screen"
            header display="flex" align-items="center" padding="8px 16px"
              // Back, a swipe down and Escape press this, so leaving the screen always stops the recorder.
              button id="back" press=stopRecording disabled=pending(saved) aria-label="Stop and draft the note" testId="record-back"
                image "symbol:stop-fill"
              text "Recording" role="heading" aria-level=2
            scroll id="record-scroll" flex=1 min-height=0
              column gap=16 padding=16 max-width="45rem" width="100%" margin="0 auto" box-sizing="border-box"
                column gap=10 padding=16 border-radius=16 background-color="attention.soft" align-items="center"
                  text (recRef != "" ? recRef : `No ${brand.person} reference`) font="-exact-headline" color="attention.ink" testId="rec-ref"
                  row gap=8 align-items="center"
                    view width=10 height=10 border-radius=5 background-color="attention.ink"
                    text clock(rec.duration / 1000) font="-exact-large-title" font-variant-numeric="tabular-nums"
                      color="attention.ink" testId="elapsed"
                  // A literal only: tools/tenant.mjs writes the tenant's attention ink here.
                  audio-waveform track=trackId tint="#8c3426" width="100%" height=72 testId="waveform"
                  button press=stopRecording buttonStyle="filled" disabled=pending(saved) testId="stop-recording"
                    image "symbol:stop-fill"
                    text (pending(saved) ? "Saving…" : "Stop and draft the note")
                if brand.jottings
                  column gap=6
                    text "Your jottings" font="-exact-headline"
                    text "The draft uses these too. Avoid full names and dates of birth." font="-exact-footnote" color="text.muted"
                    textarea value=recJottings input=editRecJottings markup="markdown" placeholder="- BP, findings, follow-ups"
                      aria-label="Your jottings" rows=8 testId="record-jottings" min-height=180
        if e.name == "note"
          column navigationKey=`${e.id}` navigationScroll="note-scroll" position="absolute" inset=0
            display="flex" flex-direction="column"
            header display="flex" align-items="center" gap=8 padding="8px 16px"
              text "Note" role="heading" aria-level=2 flex=1
              button press=askDelete(e.params.id) aria-label="Delete note" testId="delete-note"
                image "symbol:delete"
            if detail.found
              scroll id="note-scroll" flex=1 min-height=0
                column gap=16 padding=16 max-width="45rem" width="100%" margin="0 auto" box-sizing="border-box"
                  column gap=4
                    input value=(detail.patientRef == `No ${brand.person} reference` ? "" : detail.patientRef) change=commitRef
                      placeholder=`${brand.Person} reference` aria-label=`${brand.Person} reference` border="none" font="-exact-title2"
                      testId="ref-field"
                    text `${detail.templateName} · ${formatDate(detail.createdAt, time.utcOffset, "medium")} · ${formatTime(detail.createdAt, time.utcOffset, "short")} · ${lasted(detail.durationS)}`
                      font="-exact-footnote" color="text.muted" testId="detail-meta"
                  if brand.playback and detail.audio != ""
                    audio src=detail.audio controls=true preload="metadata" width="100%" testId="player"
                  if setup.demo
                    text setup.demoNote font="-exact-footnote" color="notice.ink" testId="detail-demo-note"
                  if detail.state == "processing"
                    column gap=8 padding=14 border-radius=14 background-color="progress.soft" testId="working-card"
                      text detail.stateLabel color="progress.ink" font="-exact-headline" testId="working-label"
                      progress value=detail.progress max=1 aria-label=detail.stateLabel
                  if detail.state == "failed"
                    column gap=8 padding=14 border-radius=14 background-color="attention.soft" testId="failed-card"
                      text "The draft could not be written" color="attention.ink" font="-exact-headline"
                      text detail.error color="attention.ink" font="-exact-footnote" testId="failed-error"
                      button press=retry buttonStyle="bordered" disabled=pending(rerun) testId="retry"
                        text "Try again"
                  row role="radiogroup" aria-label="Show" width="100%"
                    button role="radio" aria-checked=(pane == "note") press=showPane("note") flex=1 testId="pane-note"
                      text "Note"
                    button role="radio" aria-checked=(pane == "transcript") press=showPane("transcript") flex=1 testId="pane-transcript"
                      text "Transcript"
                    if brand.jottings
                      button role="radio" aria-checked=(pane == "jottings") press=showPane("jottings") flex=1 testId="pane-jottings"
                        text "Jottings"
                  if pane == "note"
                    if done and detail.note != ""
                      if detail.state != "reviewed"
                        column gap=4 padding=12 border-radius=12 background-color="notice.soft" testId="ai-draft-label"
                          text (detail.hasEdits ? "AI draft, edited by you · Not reviewed" : "AI draft · Not reviewed") color="notice.ink" font="-exact-headline"
                          text brand.reviewDisclaimer color="notice.ink" font="-exact-footnote"
                      else
                        row gap=8 align-items="center" padding=12 border-radius=12 background-color="progress.soft" testId="reviewed-label"
                          image "symbol:checkmark" color="progress.ink"
                          text `Reviewed ${formatDate(detail.reviewedAt, time.utcOffset, "medium")} · ${formatTime(detail.reviewedAt, time.utcOffset, "short")}`
                            color="progress.ink" font="-exact-headline" flex=1 min-width=0
                      if editing
                        column gap=6
                          textarea value=shownNote input=editNote markup="markdown" aria-label="Note" rows=16 min-height=320
                            testId="note-editor"
                          row gap=8 align-items="center"
                            text (editDirty ? "Saving…" : "Saved on this device") font="-exact-footnote" color="text.muted" flex=1 testId="edit-state"
                            button press=stopEditing buttonStyle="bordered" testId="done-editing"
                              text "Done"
                      else
                        column gap=10 padding=16 border-radius=14 background-color="surface.card"
                          text shownNote markup="markdown" testId="note-text"
                        row gap=8 flex-wrap="wrap"
                          button press=startEditing buttonStyle="bordered" testId="edit-note"
                            image "symbol:pencil"
                            text "Edit"
                          if detail.state != "reviewed"
                            button press=markReviewed buttonStyle="filled" disabled=(pending(reviewed) or editDirty) testId="mark-reviewed"
                              image "symbol:checkmark"
                              text "Mark as reviewed"
                          else
                            if brand.copy
                              button press=copyNote buttonStyle="filled" testId="copy-note"
                                image "symbol:copy"
                                text (copied ? "Copied" : "Copy note")
                            if brand.share
                              button press=shareNote buttonStyle="bordered" testId="share-note"
                                image "symbol:share"
                                text "Share"
                      button press=askWriteAgain disabled=(pending(rerun) or not done) testId="write-again"
                        image "symbol:refresh"
                        text "Write again"
                    else
                      text (detail.state == "processing" ? "The draft appears here when the transcript is ready." : "No draft for this note.")
                        color="text.muted" testId="note-empty"
                  if pane == "transcript"
                    if detail.state != "processing"
                      button press=askTranscribeAgain disabled=pending(rerun) testId="transcribe-again"
                        image "symbol:refresh"
                        text "Transcribe again"
                    if detail.segments.length == 0
                      text (detail.state == "processing" ? "Transcribing…" : "No speech was found in this recording.") color="text.muted" testId="transcript-empty"
                    else
                      column gap=10 testId="transcript"
                        for s in detail.segments key=s.id
                          row gap=12 align-items="flex-start"
                            text s.at font="-exact-footnote" color="text.muted" font-variant-numeric="tabular-nums" width="2.75rem" flex-shrink=0
                            text s.text flex=1 min-width=0
                  if pane == "jottings"
                    column gap=6
                      textarea value=shownJottings input=editJottings markup="markdown" placeholder="Write in Markdown"
                        aria-label="Your jottings" rows=10 min-height=220 testId="jottings"
                      text (jotDirty ? "Saving…" : "Saved on this device. Write again to use them in the draft.") font="-exact-footnote" color="text.muted" testId="jottings-state"
            else if not pending(detail)
              EmptyState(symbol="symbol:alert", title="No such note", message="It may have been deleted.")
                button press=back buttonStyle="filled" testId="missing-back"
                  text "Back to notes"
        if e.name == "settings"
          column navigationKey=`${e.id}` navigationScroll="settings-list" position="absolute" inset=0
            display="flex" flex-direction="column"
            header display="flex" align-items="center" padding="8px 16px"
              text "Settings" role="heading" aria-level=2
            list id="settings-list" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 testId="settings"
              section
                header
                  text "This device"
                row
                  text setup.deviceLine flex=1 testId="settings-device"
                footer
                  text `${setup.recommendedLabel} is the best fit here.` testId="settings-recommended"
              section
                header
                  text "Models"
                button press=pick("auto") testId="tier-auto"
                  column flex=1 min-width=0 gap=2
                    text `Automatic (${setup.recommendedLabel})`
                    text "Use the best fit for this device." font="-exact-footnote" color="-exact-secondary-label"
                  if choice == "auto"
                    image "symbol:checkmark"
                for t in setup.tiers key=t.id
                  button press=pick(t.id) disabled=(not t.runnable) testId=`pick-${t.id}`
                    column flex=1 min-width=0 gap=2
                      text t.label
                      text t.blurb font="-exact-footnote" color="-exact-secondary-label"
                      text (t.runnable ? tierLine(t) : t.reason) font="-exact-footnote" color="-exact-secondary-label"
                        testId=`tier-line-${t.id}`
                    if choice == t.id
                      image "symbol:checkmark"
                  if t.runnable
                    TierDownload(tier=t, download=download(t.id), remove=removeTier(t.id))
                footer
                  text "A lighter model uses less memory and battery. A larger one writes better drafts."
              section
                header
                  text "Privacy"
                footer
                  text brand.privacy testId="settings-privacy"
              if brand.supportEmail != "" or brand.supportUrl != "" or brand.supportHours != ""
                section testId="settings-support"
                  header
                    text "Support"
                  if brand.supportEmail != ""
                    button press=openSupportMail testId="support-email"
                      text brand.supportEmail
                  if brand.supportUrl != ""
                    button press=openSupportPage testId="support-url"
                      text brand.supportUrl
                  if brand.supportHours != ""
                    row
                      text brand.supportHours font="-exact-footnote" color="-exact-secondary-label" flex=1
              section
                header
                  text "About"
                row
                  text brand.name flex=1
                  text `Version ${brand.version}` color="-exact-secondary-label" testId="settings-version"
      dialog id="delete-note" role="alertdialog" aria-label="Delete this note?"
        text "Its recording, transcript, draft and your edits are removed from this device."
        button press=remove(aimed) destructive=true commandfor="delete-note" command="close" testId="delete-confirm"
          text "Delete"
        button commandfor="delete-note" command="close" testId="delete-cancel"
          text "Cancel"
      dialog id="replace-edits" role="alertdialog" aria-label="Replace your edits?"
        text (replacing == "transcribe" ? "Transcribing again writes a new draft. Your edits to this note are discarded." : "A new draft replaces this one. Your edits to this note are discarded.")
        button press=replaceEdits destructive=true commandfor="replace-edits" command="close" testId="replace-confirm"
          text "Replace edits"
        button commandfor="replace-edits" command="close" testId="replace-cancel"
          text "Keep edits"

// The sheet before a recording: who it is about, in which template.
component NewNote
  props
    route: number
    brand: Brand
    opening: bool
    failure: string
    start: action
    cancel: action
  state ref = ""
  state template = ""
  derive chosen = template != "" ? template : brand.defaultTemplate
  action editRef(v: string)
    ref = v
  action choose(id: string)
    template = id
  view
    column navigationKey=`${route}` navigationPresentation="modal" position="absolute" inset=0 testId="new-note"
      header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
        button id="back" press=cancel aria-label="Cancel" testId="new-cancel"
          image "symbol:close"
        text "New note" role="heading"
      list appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
        section
          header
            text `${brand.Person} reference`
          row
            input value=ref input=editRef placeholder="Optional, such as initials or a bed number" aria-label=`${brand.Person} reference`
              flex=1 min-width=0 testId="new-ref"
          footer
            text `Use a short reference you will recognize. Avoid full names, dates of birth and record numbers.`
        section
          header
            text "Note template"
          for t in brand.templates key=t.id
            button press=choose(t.id) testId=`template-${t.id}`
              column flex=1 min-width=0 gap=2
                text t.name
                text t.description font="-exact-footnote" color="-exact-secondary-label"
                text t.headings font="-exact-footnote" color="-exact-secondary-label"
              if chosen == t.id
                image "symbol:checkmark"
          footer
            text (failure != "" and not opening ? `Recording didn’t start (${failure}).` : `Ask the ${brand.person} for consent before you record.`)
              testId="new-footer"
      column gap=8 padding=16 max-width="45rem" width="100%" margin="0 auto" box-sizing="border-box"
        button press=start(ref, chosen) buttonStyle="filled" disabled=opening testId="start-recording"
          image "symbol:microphone"
          text (opening ? "Opening microphone…" : "Start recording")

component Promise
  props
    symbol: string
    text: string
  view
    row gap=10 align-items="center"
      image symbol color="accent"
      text text font="-exact-footnote" color="text.muted" flex=1 min-width=0

// What the active tier still needs before a note can be drafted.
component ModelBanner
  props
    setup: Setup
    download: action
    openSettings: action
  view
    column gap=8
      if setup.demo
        row gap=8 padding=12 border-radius=14 background-color="notice.soft" testId="demo-banner"
          text setup.demoNote color="notice.ink" font="-exact-footnote" flex=1 min-width=0
      if setup.ready and setup.activeDownloading
        column gap=8 padding=14 border-radius=14 background-color="progress.soft" testId="download-card"
          text `Downloading ${setup.activeLabel} models · ${percent(setup.activeProgress)}` color="progress.ink" font="-exact-headline" testId="download-label"
          progress value=setup.activeProgress max=1 aria-label="Model download"
      else if setup.ready and not setup.activeInstalled
        column gap=8 padding=14 border-radius=14 background-color="progress.soft" testId="models-needed"
          text `${setup.activeLabel} models are not on this device yet.` color="progress.ink" font="-exact-headline"
          if setup.activeError != ""
            text setup.activeError color="attention.ink" font="-exact-footnote" testId="download-error"
          text "New recordings are transcribed once the models are downloaded." color="progress.ink" font="-exact-footnote"
          row gap=8 flex-wrap="wrap"
            button press=download buttonStyle="filled" testId="download-models"
              text "Download"
            button press=openSettings testId="choose-model"
              text "Choose another"

component NewNoteCard
  props
    brand: Brand
    recording: bool
    opening: bool
    denied: bool
    available: bool
    failure: string
    start: action
    openSystemSettings: action
  view
    column gap=10 padding=20 border-radius=18 background-color="surface.raised" border="1px solid" border-color="line.soft"
      align-items="center" box-sizing="border-box" testId="record-card"
      text "Ready for your next consultation" font="-exact-title3" text-align="center"
      button press=start buttonStyle="filled" disabled=(opening or recording or denied or not available) testId="new-note-button"
        max-width="100%"
        image "symbol:add"
        text "New note"
      if denied
        text `The microphone is off for ${brand.name}. Turn it on in Settings to record.` font="-exact-footnote" color="attention.ink" text-align="center" testId="mic-denied"
        button press=openSystemSettings testId="mic-settings"
          text "Open Settings"
      else if not available
        text "Recording is not available on this device." font="-exact-footnote" color="text.muted" text-align="center" testId="mic-unavailable"

component StateChip
  props
    state: string
    label: string
    progress: number
  view
    if state == "reviewed"
      Badge(label=label, tint=some("progress.ink"))
    else if state == "draft"
      Badge(label=label, tint=some("notice.ink"))
    else if state == "failed"
      Badge(label=label, tint=some("attention.ink"))
    else
      Badge(label=`${label} ${percent(progress)}`, tint=some("text.muted"))

// Whether a tier's models are on this device, with the button that changes it.
component TierDownload
  props
    tier: TierView
    download: action
    remove: action
  view
    row gap=8 align-items="center" testId=`tier-state-${tier.id}`
      if tier.downloading
        text `Downloading ${tier.label} · ${percent(tier.progress)}` font="-exact-footnote" color="-exact-secondary-label" flex=1
      else if tier.installed
        text `${tier.label} is on this device` font="-exact-footnote" color="-exact-secondary-label" flex=1 testId=`tier-installed-${tier.id}`
        button press=remove testId=`remove-${tier.id}`
          text "Remove"
      else
        text (tier.error != "" ? tier.error : `${tier.label} is not downloaded`) font="-exact-footnote" color="-exact-secondary-label" flex=1
        button press=download testId=`download-${tier.id}`
          text "Download"
