test "first launch checks the device and recommends a tier"
  clock data
  expect tree has "welcome"
  expect tree has "recommended"
  expect tree has "demo-note"

test "continue downloads the models, then the home screen is ready for a note"
  clock data
  tap "continue"
  clock data
  expect tree missing "welcome"
  expect tree has "download-card"
  clock +6000
  clock data
  expect tree missing "download-card"
  expect tree missing "models-needed"
  expect tree has "new-note-button"
  reload
  expect tree missing "welcome"

test "not now skips the download, and the home screen says models are needed"
  clock data
  tap "skip-download"
  clock data
  expect tree has "models-needed"
  tap "download-models"
  clock data
  clock +6000
  clock data
  expect tree missing "models-needed"

test "a new note asks for a reference and a template, and cancel goes back"
  clock data
  tap "skip-download"
  clock data
  tap "new-note-button"
  clock settle
  expect tree has "new-note"
  type "new-ref" "Bed 4"
  expect text "new-ref" == "Bed 4"
  tap "new-cancel"
  clock settle
  expect tree missing "new-note"
  expect tree has "new-note-button"
